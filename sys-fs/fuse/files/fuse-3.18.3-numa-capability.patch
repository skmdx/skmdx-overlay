+
+static void *fuse_ring_alloc(struct fuse_ring_pool *ring, size_t size)
+{
+	if (ring->use_numa)
+		return numa_alloc_local(size);
+	void *memory = mmap(NULL, size, PROT_READ | PROT_WRITE,
+			    MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+	return memory == MAP_FAILED ? NULL : memory;
+}
+
+static void fuse_ring_free(struct fuse_ring_pool *ring, void *memory, size_t size)
+{
+	if (!memory)
+		return;
+	if (ring->use_numa)
+		numa_free(memory, size);
+	else
+		munmap(memory, size);
+}
 
