+++ b/tests/test_posix_quoting.py
@@ -0,0 +1,49 @@
+"""Execute real libdash parse/Shasta print round trips for configure quoting."""
+import subprocess
+import sys
+
+import pytest
+
+
+@pytest.mark.parametrize("source", [
+    # Redirection applies to the entire command list, including the first arm.
+    "{ printf first && printf second; } > result; printf marker; cat result; rm result\n",
+    "{ printf first; printf second; } > result; printf marker; cat result; rm result\n",
+    "{ printf first || printf second; } > result; printf marker; cat result; rm result\n",
+    # Autoconf config.status sed grouping inside a double-quoted assignment.
+    r'''expr="s/\(=[ ]*\).*/\1/"
+printf '%s\n' 'key= value' | sed "$expr"
+''',
+    # Autoconf defines.awk uses a quoted heredoc and an AWK dollar expression.
+    '''cat <<'EOF'
+line = $ 0
+"quotes" 'apostrophe' `backticks` \\ $VAR ${VAR} $(false)
+EOF
+''',
+    # Expanding heredocs still expand variables and preserve literal escapes.
+    r'''VAR=expanded
+cat <<EOF
+"quotes" 'apostrophe' (paren) {brace} & | ; $VAR \$VAR \\ \\(
+EOF
+''',
+    r'''printf '%s\n' "' ( ) { } & | ;" "\$" "\`" "\\" "\""
+''',
+])
+def test_posix_quoting_roundtrip(tmp_path, source):
+    script = tmp_path / "original.sh"
+    script.write_text(source)
+    # libdash has process-global state, so isolate it from other parser tests.
+    parser = """
+import sys
+import libdash.parser
+from shasta.json_to_ast import to_ast_node
+for ast, _, _, _ in libdash.parser.parse(sys.argv[1]):
+    print(to_ast_node(ast).pretty())
+"""
+    regenerated = subprocess.run([sys.executable, "-c", parser, str(script)],
+        capture_output=True, check=True, timeout=10).stdout
+    expected = subprocess.run(["bash", str(script)], capture_output=True, cwd=tmp_path, timeout=10)
+    actual = subprocess.run(["bash"], input=regenerated, capture_output=True, cwd=tmp_path, timeout=10)
+    assert expected.returncode == 0
+    assert (actual.returncode, actual.stdout, actual.stderr) == (
+        expected.returncode, expected.stdout, expected.stderr)
